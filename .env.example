# SQLite file for local dev without Docker. In Docker the backend image sets its own
# DATABASE_URL (sqlite:////data/paylark.db, on the app_data volume).
DATABASE_URL=sqlite:///./paylark.db

NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_APP_VERSION=dev
# Seconds between proactive session-expiry checks on an idle authenticated tab.
NEXT_PUBLIC_SESSION_HEARTBEAT_SECONDS=180

# Set to a non-development value (e.g. production) on real deployments — this
# gates cookie `secure`, JWT secret strength, and password-reset token expiry
# checks below (all permissive by default so local dev over http keeps working).
ENVIRONMENT=development

JWT_SECRET=changeme-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Email (optional, nice-to-have) ---
# Used for reminders, the monthly summary and password-reset mails. Delivery goes
# through Apprise (mailto://), which the backend builds from these variables.
# Leave SMTP_HOST unset to turn email off.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=changeme
# SMTP_USE_TLS=true            # true = STARTTLS (587); false = plain, no TLS
# REMINDER_FROM=noreply@yourdomain.com   # defaults to SMTP_USER
# Domains whose users are silently skipped by the email scheduler (JSON array).
# Default already blocks test.com and example.com.
# EMAIL_BLOCKED_DOMAINS=["test.com","example.com"]

# --- Telegram (optional) ---
# Nothing to set here: every user pastes their own bot token and chat id in
# Settings -> Notifications (see context/foundation/telegram-setup.md).
# Tokens are stored encrypted with a key derived from JWT_SECRET, so changing
# JWT_SECRET later means users have to re-enter their Telegram bot token.

# --- Time zone ---
# Zone (IANA name, e.g. Europe/Warsaw) given to accounts whose browser doesn't report
# one, and to the existing accounts when upgrading to per-user time zones: their
# reminder send times, until then in UTC, are converted to it so nothing is sent at a
# different moment. Set it BEFORE upgrading; changing it afterwards converts nothing.
# DEFAULT_TIMEZONE=UTC

# --- Rate limiting (login, register, forgot/reset password) ---
# Leave on. Behind a reverse proxy, also set FORWARDED_ALLOW_IPS to the proxy's
# address so limits apply per client instead of per proxy.
# RATE_LIMIT_ENABLED=true

# --- Password reset ---
APP_BASE_URL=http://localhost:3010
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --- Restore safety net ---
# Days a pre-restore snapshot stays recoverable before the cleanup job deletes it.
RESTORE_SNAPSHOT_RETENTION_DAYS=7
